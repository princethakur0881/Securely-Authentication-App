
# Local development environment variables
# Copy values into your private .env file.
# Never commit real credentials.

DB_URL=jdbc:mysql://localhost:3306/your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=replace_with_local_password

MAIL_USERNAME=your_email@example.com
MAIL_APP_PASSWORD=replace_with_gmail_app_password

APP_FRONTEND_URL=http://localhost:3000
APP_VERIFICATION_BASE_URL=http://localhost:3000/?verify=1
APP_PASSWORD_RESET_BASE_URL=http://localhost:3000/#/reset-password